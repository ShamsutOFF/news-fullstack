package components

templ Header() {
    @HeaderStyle()
    <header class="header">
        <!-- Левая часть - навигация -->
        <nav class="header-nav">
            <a href="/news" class="nav-item nav-item--active">Новости</a>
            <a href="/categories" class="nav-item nav-item--dropdown">
                Категории
                <span class="dropdown-arrow">▼</span>
            </a>
            <a href="/contacts" class="nav-item">Контакты</a>
        </nav>

        <!-- Центральная часть - пустое пространство -->
        <div class="header-space"></div>

        <!-- Правая часть - поиск и профиль -->
        <div class="header-actions">
            <!-- Поисковая строка -->
            <div class="search-container">
                <input
                    type="text"
                    placeholder="Найти Новость"
                    class="search-input"
                />
                <span class="search-icon">🔍</span>
            </div>

            <!-- Профиль пользователя -->
            <div class="profile-container">
                <img
                    src="/public/images/avatar.jpg"
                    alt="Аватар"
                    class="profile-avatar"
                />
                <span class="profile-name">Василий</span>
                <span class="dropdown-arrow">▼</span>
            </div>
        </div>
    </header>
}

templ HeaderStyle() {
 <style>
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between; /* Изменено с center на space-between */
            height: 70px;
            background: #ffffff;
            padding: 0 20px;
            border-bottom: 1px solid #f0f0f0;
            font-family: Arial, sans-serif;
            max-width: 1500px; /* Добавлено - такая же ширина как у контента */
            margin: 0 auto; /* Центрируем */
            width: 100%; /* Занимает всю доступную ширину */
            box-sizing: border-box;
        }

        /* Левая часть - навигация */
        .header-nav {
            display: flex;
            align-items: center;
            gap: 40px;
            flex-shrink: 0; /* Не сжимается */
        }

        .nav-item {
            text-decoration: none;
            color: #000000;
            font-size: 16px;
            font-weight: normal;
            transition: color 0.2s ease;
            white-space: nowrap; /* Текст не переносится */
        }

        .nav-item:hover {
            color: #666666;
        }

        .nav-item--active {
            color: #FF0000;
            font-weight: bold;
            font-size: 20px;
        }

        .nav-item--dropdown {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dropdown-arrow {
            font-size: 12px;
            color: #666666;
        }

        /* Центральная часть - пустое пространство */
        .header-space {
            flex: 1;
            min-width: 20px; /* Уменьшено */
        }

        /* Правая часть - поиск и профиль */
        .header-actions {
            display: flex;
            align-items: center;
            gap: 15px; /* Уменьшено */
            flex-shrink: 0; /* Не сжимается */
        }

        /* Поисковая строка */
        .search-container {
            position: relative;
            min-width: 200px; /* Уменьшено */
            flex-shrink: 1; /* Может сжиматься */
        }

        .search-input {
            width: 100%;
            padding: 8px 35px 8px 12px; /* Уменьшено */
            border: none;
            border-radius: 8px;
            background: #f5f5f5;
            font-size: 14px;
            outline: none;
            transition: background 0.2s ease;
            box-sizing: border-box;
        }

        .search-input:focus {
            background: #eeeeee;
        }

        .search-input::placeholder {
            color: #999999;
        }

        .search-icon {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #666666;
            font-size: 12px;
        }

        /* Профиль пользователя */
        .profile-container {
            display: flex;
            align-items: center;
            gap: 6px; /* Уменьшено */
            padding: 4px 8px; /* Уменьшено */
            border-radius: 20px;
            cursor: pointer;
            transition: background 0.2s ease;
            flex-shrink: 0; /* Не сжимается */
        }

        .profile-container:hover {
            background: #f9f9f9;
        }

        .profile-avatar {
            width: 32px; /* Уменьшено */
            height: 32px; /* Уменьшено */
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #f0f0f0;
        }

        .profile-name {
            font-size: 13px; /* Уменьшено */
            color: #000000;
            font-weight: normal;
            white-space: nowrap;
        }
    </style>
}