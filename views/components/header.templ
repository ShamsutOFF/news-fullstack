package components

import "context"

templ Header() {
	@HeaderStyle()
	<header class="header">
		<!-- Левая часть - навигация -->
		<nav class="header-nav">
			<a href="/home" class="nav-item nav-item--active">Новости</a>
			<a href="/categories" class="nav-item nav-item--dropdown">
				Категории
				<span class="dropdown-arrow">▼</span>
			</a>
			<a href="/contacts" class="nav-item">Контакты</a>
		</nav>
		<!-- Центральная часть - пустое пространство -->
		<div class="header-space"></div>
		<!-- Правая часть - для неавторизованных пользователей -->
		<div class="header-actions">
			// Показываем приветствие если пользователь авторизован
			{{ email := getUserEmail(ctx) }}
			if email != "" {
				<div class="profile">
					Привет, { email }! | <a href="/users/logout">Выйти</a>
				</div>
			} else {
				<!-- Ссылки входа и регистрации -->
				<div class="auth-links">
					<a href="/login" class="auth-link">Вход</a>
					<a href="/register" class="auth-link auth-link--primary">Регистрация</a>
				</div>
			}
		</div>
	</header>
}

// Функция для получения email из контекста
func getUserEmail(ctx context.Context) string {
	// Получаем email из контекста Fiber
	if email, ok := ctx.Value("user_email").(string); ok {
		return email
	}
	return ""
}

templ HeaderStyle() {
	<style>
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 70px;
            background: var(--color-white);
            padding: 0 20px;
            border-bottom: 1px solid #f0f0f0;
            font-family: Arial, sans-serif;
            max-width: 1500px;
            margin: 0 auto;
            width: 100%;
            box-sizing: border-box;
        }

        .profile {
            background: #e8f5e8; 
            padding: 10px; 
            margin-bottom: 20px; 
            border-radius: 5px;"
        }

        /* Левая часть - навигация */
        .header-nav {
            display: flex;
            align-items: center;
            gap: 40px;
            flex-shrink: 0;
        }

        .nav-item {
            text-decoration: none;
            color: var(--color-black);
            font-size: 16px;
            font-weight: normal;
            transition: color 0.2s ease;
            white-space: nowrap;
        }

        .nav-item:hover {
            color: #666666;
        }

        .nav-item--active {
            color: var(--color-primary);
            font-weight: bold;
            font-size: 20px;
        }

        .nav-item--dropdown {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .dropdown-arrow {
            font-size: 12px;
            color: #666666;
        }

        /* Центральная часть - пустое пространство */
        .header-space {
            flex: 1;
            min-width: 20px;
        }

        /* Правая часть - авторизация */
        .header-actions {
            display: flex;
            align-items: center;
            gap: 15px;
            flex-shrink: 0;
        }

        /* Ссылки входа и регистрации */
        .auth-links {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .auth-link {
            text-decoration: none;
            color: var(--color-black);
            font-size: 16px;
            font-weight: normal;
            transition: color 0.2s ease;
            padding: 8px 16px;
            border-radius: 6px;
        }

        .auth-link:hover {
            color: var(--color-primary);
            background: #f9f9f9;
        }

        .auth-link--primary {
            background: var(--color-primary);
            color: var(--color-white);
            font-weight: 500;
        }

        .auth-link--primary:hover {
            background: var(--color-primary-hover);
            color: var(--color-white);
        }

        /* Стили для авторизованного состояния (пока скрыты) */
        .search-container {
            position: relative;
            min-width: 200px;
            flex-shrink: 1;
            display: none; /* Скрываем для неавторизованных */
        }

        .search-input {
            width: 100%;
            padding: 8px 35px 8px 12px;
            border: none;
            border-radius: 8px;
            background: #f5f5f5;
            font-size: 14px;
            outline: none;
            transition: background 0.2s ease;
            box-sizing: border-box;
        }

        .search-input:focus {
            background: #eeeeee;
        }

        .search-input::placeholder {
            color: #999999;
        }

        .search-icon {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #666666;
            font-size: 12px;
        }

        .profile-container {
            display: none; /* Скрываем для неавторизованных */
            align-items: center;
            gap: 6px;
            padding: 4px 8px;
            border-radius: 20px;
            cursor: pointer;
            transition: background 0.2s ease;
            flex-shrink: 0;
        }

        .profile-container:hover {
            background: #f9f9f9;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #f0f0f0;
        }

        .profile-name {
            font-size: 13px;
            color: var(--color-black);
            font-weight: normal;
            white-space: nowrap;
        }
    </style>
}
