// views/components/footer.templ
package components

templ Footer() {
    @FooterStyle()
    <footer class="footer">
        <div class="footer-content">
            <p>&copy; 2025 News Fullstack. Все права защищены.</p>
            <div class="footer-links">
                <a href="/contact">Контакты</a>
                <a href="/privacy">Политика конфиденциальности</a>
                <a href="/terms">Условия использования</a>
            </div>
        </div>
    </footer>
}

templ FooterStyle() {
    <style>
        .footer {
            background: #F5F5F5; /* Такой же серый фон как у карточек */
            width: 100%;
            padding: 20px 0;
            margin-top: auto; /* Важно для приклеивания к низу */
            border-top: 1px solid #E0E0E0;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            text-align: center;
        }

        .footer-content p {
            margin: 0 0 10px 0;
            color: #666;
            font-size: 14px;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: #666;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.2s;
        }

        .footer-links a:hover {
            color: #333;
        }
    </style>
}