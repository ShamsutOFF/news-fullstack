package components

import "news-fullstack/views/types"

templ ArticleCard(article types.ArticleCard) {
    @ArticleCardStyle()
    <div class="article-card">
        <!-- Верхняя часть - изображение -->
        <div class="article-image">
            <img src={ article.ImageURL } alt={ article.Title } />
        </div>

        <!-- Контентная часть -->
        <div class="article-content">
            <!-- Заголовок -->
            <h3 class="article-title">{ article.Title }</h3>

            <!-- Краткое описание -->
            <p class="article-description">{ article.Description }</p>

            <!-- Блок с автором и датой -->
            <div class="article-meta">
                <div class="author-info">
                    <img src={ article.AuthorAvatar } alt={ article.AuthorName } class="author-avatar" />
                    <div class="author-details">
                        <span class="author-name">{ article.AuthorName }</span>
                        <span class="publish-date">{ article.PublishDate }</span>
                    </div>
                </div>

                <!-- Иконка закладки -->
                <button class="bookmark-btn" type="button">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
}

templ ArticleCardStyle() {
    <style>
        .article-card {
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            max-width: 340px;
        }

        .article-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

        /* Верхняя часть - изображение */
        .article-image {
            width: 100%;
            height: 200px;
            overflow: hidden;
        }

        .article-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        /* Контентная часть */
        .article-content {
            padding: 20px;
        }

        /* Заголовок */
        .article-title {
            font-size: 24px;
            font-weight: bold;
            color: #000000;
            margin: 0 0 12px 0;
            line-height: 1.2;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* Краткое описание */
        .article-description {
            font-size: 16px;
            color: #666666;
            margin: 0 0 20px 0;
            line-height: 1.4;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* Блок с автором и датой */
        .article-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8f9fa;
            border-radius: 8px;
            padding: 12px;
        }

        .author-info {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
        }

        .author-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e9ecef;
        }

        .author-details {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .author-name {
            font-size: 14px;
            font-weight: 500;
            color: #000000;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .publish-date {
            font-size: 12px;
            color: #6c757d;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        /* Иконка закладки */
        .bookmark-btn {
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
            border-radius: 6px;
            transition: background-color 0.2s ease;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bookmark-btn:hover {
            background-color: #e9ecef;
            color: #495057;
        }

        .bookmark-btn svg {
            display: block;
        }
    </style>
}