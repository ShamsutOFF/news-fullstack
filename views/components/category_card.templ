package views

templ CategoryCard(name string, imageURL string) {
    @CategoryCardStyle()
    <button class="category-card" type="button">
        <img class="card-background" src={ templ.URL(imageURL) } alt={ name } />
        <span class="card-text">#{ name }</span>
    </button>
}

templ CategoryCardStyle() {
    <style>
        .category-card {
            position: relative;
            width: 170px;
            height: 48px;
            border-radius: 12px;
            border: none;
            overflow: hidden;
            cursor: pointer;
            padding: 0;
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover; /* Важно! Чтобы картинка заполнила область */
            filter: blur(2px);
            z-index: 1;
        }

        .card-text {
            position: relative;
            z-index: 2;
            color: white;
            font-weight: bold;
            font-size: 14px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.7);
        }
    </style>
}