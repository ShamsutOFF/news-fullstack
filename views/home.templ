package views

import "news-fullstack/views/layout"
import "news-fullstack/views/components"
import "news-fullstack/views/types"

templ HomePage(
    categories []types.Category,
    banners []types.BannerCard,
    articles []types.ArticleCard,
    ) {
    @layout.Layout(layout.LayoutProps{
        Title: "Новостной портал - Главная",
        MetaDescription: "Самые свежие новости по всем категориям",
    }) {
        @HomePageStyle()
        <div class="page-container">
            <!-- Список категорий -->
            @components.CategoriesRow(categories)

            <!-- Баннерная секция -->
            <div class="banners-section">
                @components.BannersRow(banners)
            </div>

            <!-- Секция с карточками статей -->
            @components.ArticlesRow(articles)
        </div>
    }
}

templ HomePageStyle() {
    <style>
        .page-container {
            max-width: 1500px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .banners-section {
            display: flex;
            gap: 20px;
            justify-content: flex-start;
            margin: 30px 0;
            flex-wrap: wrap;
        }

        .articles-section {
            margin: 40px 0;
        }

        .section-title {
            font-size: 28px;
            color: #333;
            margin-bottom: 24px;
            font-weight: bold;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }

        .articles-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 24px;
        }
    </style>
}