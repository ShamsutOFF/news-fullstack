package views

import "news-fullstack/views/layout"
import "news-fullstack/views/components"
import "news-fullstack/views/types"

templ HomePage(categories []types.Category) {
    @layout.Layout(layout.LayoutProps{
        Title: "Новостной портал - Главная",
        MetaDescription: "Самые свежие новости по всем категориям",
    }) {
        <div class="home-page">
            <!-- Контент страницы -->
            <section class="hero-section">
                <h1 class="hero-title">Добро пожаловать на Новостной портал</h1>
                <p class="hero-subtitle">Выберите интересующую категорию</p>
            </section>

            <!-- Наш список категорий -->
            @components.CategoriesRow(categories)

            <!-- Можно добавить другие секции позже -->
            <section class="news-preview">
                <h2>Самые популярные новости</h2>
                <!-- Здесь будет список новостей -->
            </section>
        </div>
    }
}

templ HomePageStyle() {
    <style>
        .home-page {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .hero-section {
            text-align: center;
            padding: 60px 0 40px 0;
        }

        .hero-title {
            font-size: 2.5rem;
            color: #333;
            margin-bottom: 16px;
            font-weight: 700;
        }

        .hero-subtitle {
            font-size: 1.2rem;
            color: #666;
            margin-bottom: 40px;
        }

        .news-preview {
            margin-top: 60px;
            padding: 40px 0;
        }

        .news-preview h2 {
            font-size: 1.8rem;
            color: #333;
            margin-bottom: 30px;
            text-align: center;
        }
    </style>
}